{
  "name": "agrishield-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --external express --external mysql2 --external jsonwebtoken --external vite && mkdir -p dist/server/migrations && cp server/db/migrations/001_initial.sql dist/server/migrations/001_initial.sql",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.511.0",
    "mysql2": "3.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "recharts": "2.15.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "tsx": "4.19.4",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
